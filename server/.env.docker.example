# Docker environment configuration for reearth-accounts

# Server Configuration
SKIP_DOTENV=true
REEARTH_HOST=0.0.0.0
REEARTH_PORT=8090

# Database Configuration
# Connect to existing MongoDB service in reearth network
REEARTH_ACCOUNTS_DB=mongodb://reearth-mongo:27017/?directConnection=true
REEARTH_ACCOUNTS_DB_NAME=reearth-account

# Cerbos Configuration
CERBOS_HOST=reearth-cerbos:3593

# CORS Configuration
REEARTH_ACCOUNTS_ORIGINS=http://localhost:3000,http://reearth-accounts-dev,https://*.netlify.app

# Trusted proxies
# Comma-separated CIDRs or IPs of the proxies in front of the server, e.g. 192.0.2.10,198.51.100.0/28.
# List only the proxies' own addresses, the load balancer's included, never a whole private range.
# Every listed address can set the client IP through X-Forwarded-For.
# Empty means the client IP is the connection address.
REEARTH_ACCOUNTS_TRUSTED_PROXIES=

# Mock auth for demo
REEARTH_MOCK_AUTH=false

# Auth0 Configuration
# These settings are shared with reearth-visualizer via authConfig GraphQL Query
# Get these values from your Auth0 application settings
REEARTH_AUTH0_DOMAIN=https://your-tenant.auth0.com/
REEARTH_AUTH0_AUDIENCE=https://api.your-domain.com
REEARTH_AUTH0_CLIENTID=your-auth0-client-id
REEARTH_AUTH0_CLIENTSECRET=your-auth0-client-secret
REEARTH_AUTH0_WEBCLIENTID=your-auth0-web-client-id

# Identity Provider Selection
# Primary identity provider for management writes (UpdateUser / ResendVerificationEmail)
# and authConfig advertisement (auth0|cip). Default: auth0.
REEARTH_ACCOUNTS_AUTH_PROVIDER=auth0

# Cloud Identity Platform (CIP) Configuration
# Leave unset for Auth0-only behavior (identical to today). When CIP_PROJECT_ID is set,
# CIP-issued JWTs are validated alongside Auth0 (multi-issuer). API_KEY/AUTH_DOMAIN are
# public client values advertised via authConfig and are not secrets.
REEARTH_ACCOUNTS_CIP_PROJECT_ID=
REEARTH_ACCOUNTS_CIP_TENANT_ID=
REEARTH_ACCOUNTS_CIP_API_KEY=
REEARTH_ACCOUNTS_CIP_AUTH_DOMAIN=
