FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab

RUN apk add --update --no-cache git ca-certificates build-base curl

# Install air for hot reload
RUN go install github.com/air-verse/air@v1.61.5

WORKDIR /reearth-accounts

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Expose port
EXPOSE 8090

# Run air for hot reload
CMD ["air", "-c", ".air.toml"]
